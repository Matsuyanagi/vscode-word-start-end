{
  "name": "word-start-end",
  "displayName": "Word Start End",
  "description": "Move the cursor left or right to the point where the character type—such as between Japanese and alphanumeric characters—switches.",
  "version": "0.0.1",
  "publisher": "Matsuyanagi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Matsuyanagi/vscode-word-start-end.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "word-start-end.cursorWordLeft",
        "title": "Move to Previous Word Boundary",
        "category": "Word Start End"
      },
      {
        "command": "word-start-end.cursorWordRight",
        "title": "Move to Next Word Boundary",
        "category": "Word Start End"
      }
    ],
    "configuration": {
      "title": "Word Start End",
      "properties": {
        "word-start-end.wordSeparators": {
          "type": ["string", "null"],
          "default": null,
          "scope": "language-overridable",
          "markdownDescription": "この拡張で使用する区切り文字。未設定または `null` の場合は、現在の文書の `#editor.wordSeparators#` を参照します。空文字列は明示的な区切り文字を無効にしますが、文字種による区切りは有効です。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
